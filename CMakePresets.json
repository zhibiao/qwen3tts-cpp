{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "QWEN3TTS_MODEL_DIR": "${sourceDir}/models",
        "QWEN3TTS_TEST_DATA_DIR": "${sourceDir}/testdata"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64"
    },
    {
      "name": "windows-cpu",
      "displayName": "Windows x64 CPU",
      "inherits": "windows-base",
      "cacheVariables": {
        "QWEN3TTS_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "windows-cuda",
      "displayName": "Windows x64 CPU + CUDA",
      "inherits": "windows-base",
      "environment": {
        "CudaToolkitDir": "$env{CUDA_PATH}/",
        "PATH": "$env{CUDA_PATH}/bin;$env{CUDA_PATH}/bin/x64;$penv{PATH}"
      },
      "cacheVariables": {
        "CUDAToolkit_ROOT": "$env{CUDA_PATH}",
        "QWEN3TTS_ENABLE_CUDA": "ON",
        "QWEN3TTS_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "windows-cuda-portable",
      "displayName": "Windows x64 CPU + CUDA portable",
      "inherits": "windows-cuda",
      "cacheVariables": {
        "QWEN3TTS_CUDA_ARCHITECTURES": "75-real;75-virtual;80-virtual;86-real;89-real;90-virtual;120a-real;121a-real"
      }
    },
    {
      "name": "windows-cpu-tests",
      "displayName": "Windows x64 CPU with tests",
      "inherits": "windows-cpu",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-cuda-tests",
      "displayName": "Windows x64 CPU + CUDA with tests",
      "inherits": "windows-cuda",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-cuda-portable-tests",
      "displayName": "Windows x64 portable CUDA with tests",
      "inherits": "windows-cuda-portable",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-cpu",
      "displayName": "Linux x86_64 CPU",
      "inherits": "linux-base",
      "cacheVariables": {
        "QWEN3TTS_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "linux-cuda",
      "displayName": "Linux x86_64 CPU + CUDA",
      "inherits": "linux-base",
      "cacheVariables": {
        "QWEN3TTS_ENABLE_CUDA": "ON",
        "QWEN3TTS_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "linux-cuda-portable",
      "displayName": "Linux x86_64 CPU + CUDA portable",
      "inherits": "linux-cuda",
      "cacheVariables": {
        "QWEN3TTS_CUDA_ARCHITECTURES": "75-real;75-virtual;80-virtual;86-real;89-real;90-virtual;120a-real;121a-real"
      }
    },
    {
      "name": "linux-cpu-tests",
      "displayName": "Linux x86_64 CPU with tests",
      "inherits": "linux-cpu",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-cuda-tests",
      "displayName": "Linux x86_64 CPU + CUDA with tests",
      "inherits": "linux-cuda",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-cuda-portable-tests",
      "displayName": "Linux x86_64 portable CUDA with tests",
      "inherits": "linux-cuda-portable",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-cuda",
      "configurePreset": "windows-cuda",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-cuda-portable",
      "configurePreset": "windows-cuda-portable",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-cpu-tests",
      "configurePreset": "windows-cpu-tests",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-cuda-tests",
      "configurePreset": "windows-cuda-tests",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-cuda-portable-tests",
      "configurePreset": "windows-cuda-portable-tests",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "linux-cpu",
      "configurePreset": "linux-cpu",
      "jobs": 0
    },
    {
      "name": "linux-cuda",
      "configurePreset": "linux-cuda",
      "jobs": 0
    },
    {
      "name": "linux-cuda-portable",
      "configurePreset": "linux-cuda-portable",
      "jobs": 0
    },
    {
      "name": "linux-cpu-tests",
      "configurePreset": "linux-cpu-tests",
      "jobs": 0
    },
    {
      "name": "linux-cuda-tests",
      "configurePreset": "linux-cuda-tests",
      "jobs": 0
    },
    {
      "name": "linux-cuda-portable-tests",
      "configurePreset": "linux-cuda-portable-tests",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu-tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cuda",
      "configurePreset": "windows-cuda-tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cuda-portable",
      "configurePreset": "windows-cuda-portable-tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-cpu",
      "configurePreset": "linux-cpu-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-cuda",
      "configurePreset": "linux-cuda-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-cuda-portable",
      "configurePreset": "linux-cuda-portable-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
